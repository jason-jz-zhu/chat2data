# Chat2Data Environment Configuration Example
# Copy this file to .env and customize as needed

# =========================================
# LLM Configuration
# =========================================

# LLM provider to use (mock, ollama)
CHAT2DATA_LLM_PROVIDER=ollama

# Default model name for LLM operations
CHAT2DATA_LLM_MODEL=llama3.2:latest

# Base URL for LLM service (for Ollama)
CHAT2DATA_LLM_URL=http://localhost:11434

# API key for LLM service (if required)
# CHAT2DATA_LLM_API_KEY=your_api_key_here

# Alternative model for SQL-specific tasks
CHAT2DATA_SQL_MODEL=sqlcoder:latest

# Model for generating embeddings
CHAT2DATA_EMBEDDING_MODEL=llama3.2:latest

# =========================================
# Database Configuration
# =========================================

# Database provider (currently only sqlite supported)
CHAT2DATA_DB_PROVIDER=sqlite

# Default database path
CHAT2DATA_DB_PATH=./data/chat2data.db

# Demo database path (used in examples and demos)
CHAT2DATA_DEMO_DB_PATH=./data/chat2data.db

# For other database types (future support)
# CHAT2DATA_DB_HOST=localhost
# CHAT2DATA_DB_PORT=5432
# CHAT2DATA_DB_USERNAME=chat2data
# CHAT2DATA_DB_PASSWORD=your_password
# CHAT2DATA_DB_NAME=chat2data

# =========================================
# Vector Store Configuration
# =========================================

# Vector store provider (semantic, memory)
CHAT2DATA_VECTOR_PROVIDER=semantic

# Ollama URL for vector operations
CHAT2DATA_VECTOR_OLLAMA_URL=http://localhost:11434

# Model for generating embeddings in vector store
CHAT2DATA_VECTOR_EMBEDDING_MODEL=llama2

# Directory for persisting vector store data
CHAT2DATA_VECTOR_PERSIST_DIR=./vector_store

# Collection name for vector store
CHAT2DATA_VECTOR_COLLECTION=chat2data

# =========================================
# UI Configuration
# =========================================

# Default LLM provider for UI
CHAT2DATA_UI_DEFAULT_PROVIDER=ollama

# Default database for UI
CHAT2DATA_UI_DEFAULT_DATABASE=./data/chat2data.db

# Streamlit server port
CHAT2DATA_UI_PORT=8501

# Streamlit server host
CHAT2DATA_UI_HOST=localhost

# =========================================
# Path Configuration
# =========================================

# Data directory
CHAT2DATA_DATA_DIR=./data

# Cache directory
CHAT2DATA_CACHE_DIR=./cache

# Logs directory
CHAT2DATA_LOGS_DIR=./logs

# Configuration directory
CHAT2DATA_CONFIG_DIR=.

# =========================================
# Adaptive Features Configuration
# =========================================

# Enable domain adaptation features (true/false)
CHAT2DATA_ENABLE_ADAPTATION=true

# Schema cache TTL in seconds
CHAT2DATA_SCHEMA_CACHE_TTL=3600

# Maximum examples per domain for dynamic templates
CHAT2DATA_MAX_EXAMPLES=10

# Enable automatic schema discovery (true/false)
CHAT2DATA_ENABLE_SCHEMA_DISCOVERY=true

# =========================================
# Development & Testing
# =========================================

# Enable debug logging (true/false)
# CHAT2DATA_DEBUG=false

# Test mode (disables certain validations)
# CHAT2DATA_TEST_MODE=false

# =========================================
# Examples
# =========================================

# Example configurations for different scenarios:

# Development with local Ollama:
# CHAT2DATA_LLM_PROVIDER=ollama
# CHAT2DATA_LLM_URL=http://localhost:11434
# CHAT2DATA_LLM_MODEL=llama3.2:latest

# Production with remote Ollama:
# CHAT2DATA_LLM_PROVIDER=ollama
# CHAT2DATA_LLM_URL=http://your-ollama-server:11434
# CHAT2DATA_LLM_MODEL=llama3.2:latest

# Demo mode:
# CHAT2DATA_LLM_PROVIDER=mock
# CHAT2DATA_DB_PATH=./data/chat2data.db

# Different database path:
# CHAT2DATA_DB_PATH=/path/to/your/database.db
# CHAT2DATA_DEMO_DB_PATH=/path/to/demo/database.db