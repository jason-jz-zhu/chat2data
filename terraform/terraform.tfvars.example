# Example Terraform variables file
# Copy this to terraform.tfvars and customize for your environment

# General Configuration
aws_region  = "us-east-1"
environment = "dev"

# VPC Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
private_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
public_subnet_cidrs  = ["10.0.101.0/24", "10.0.102.0/24", "10.0.103.0/24"]

# Aurora PostgreSQL Configuration
aurora_engine_version  = "15.3"
aurora_instance_class  = "db.t3.medium"  # Use smaller instance for dev
aurora_instance_count  = 1               # Single instance for dev
database_name          = "marketing"
master_username        = "chat2data_admin"

# OpenSearch Configuration
opensearch_version        = "2.11"
opensearch_instance_type  = "t3.small.search"  # Use smaller instance for dev
opensearch_instance_count = 1                  # Single node for dev
opensearch_ebs_volume_size = 50                # Smaller volume for dev

# Redis Configuration
redis_node_type  = "cache.t3.micro"  # Use smaller instance for dev
redis_num_nodes  = 1                 # Single node for dev

# ECS Configuration
container_image    = "123456789012.dkr.ecr.us-east-1.amazonaws.com/chat2data:latest"
container_port     = 8000
ecs_desired_count  = 1      # Single task for dev
ecs_cpu            = 1024   # 1 vCPU for dev
ecs_memory         = 2048   # 2 GB RAM for dev

# Additional Tags
tags = {
  Owner       = "DevTeam"
  CostCenter  = "Engineering"
  Application = "Chat2Data"
}
